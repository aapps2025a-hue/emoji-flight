rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  match /players/{uid} {
   allow read: if owner(uid);
   allow create, update: if owner(uid)
    && request.resource.data.keys().hasOnly(['revision','chunks','updatedAt'])
    && request.resource.data.revision is int && request.resource.data.revision > 0
    && request.resource.data.chunks is int && request.resource.data.chunks > 0 && request.resource.data.chunks <= 40
    && request.resource.data.updatedAt == request.time;
   match /chunks/{chunk} {
    allow read, delete: if owner(uid);
    allow create, update: if owner(uid)
     && request.resource.data.keys().hasOnly(['text'])
     && request.resource.data.text is string && request.resource.data.text.size() <= 800000;
   }
  }
 }
}
